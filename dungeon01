/* ===========================================================
   [1] INCLUDES E DEFINES
   ===========================================================

   #include carrega bibliotecas prontas do C:
     stdio.h  -> printf(), scanf(), getchar()
     stdlib.h -> rand(), srand(), system(), abs()
     string.h -> strncpy()
     time.h   -> time() para gerar numeros aleatorios diferentes

   #define cria um apelido para um valor constante.
   Exemplo: toda vez que o compilador ver "VILA_L", ele substitui por 10.
   Isso facilita mudar o tamanho do mapa em um unico lugar.
*/
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

/* Dimensoes dos mapas de cada fase */
#define VILA_L        10
#define VILA_C        10
#define A1_L          10
#define A1_C          10
#define A2_L          15
#define A2_C          15
#define A3_L          25
#define A3_C          25

/* MAX_C e o numero de colunas do maior mapa + 1 (para o '\0' do strncpy).
   Usamos como segundo tamanho nos arrays 2D para que o tipo
   seja compativel entre todas as funcoes. */
#define MAX_C         26

/* Numero maximo de monstros que podem existir simultaneamente */
#define MAX_MONSTROS  30

/* ===========================================================
   [2] VARIAVEIS GLOBAIS
   ===========================================================

   Variaveis globais ficam fora de qualquer funcao.
   Elas existem durante toda a execucao e sao acessiveis
   por TODAS as funcoes do programa.

   POR QUE USAR VARIAVEIS GLOBAIS AQUI?
   O estado do jogo (posicao do jogador, vidas, monstros)
   precisa ser lido e modificado por muitas funcoes diferentes.
   Sem variaveis globais, teriamos que passar dezenas de
   parametros em cada chamada de funcao.

   SEM STRUCTS — cada dado e uma variavel separada:
   Em vez de  jogador.linha  usamos  jLinha
   Em vez de  jogador.vidas  usamos  jVidas
   E assim por diante para cada campo.

   DADOS DO JOGADOR (prefixo j):
*/
int  jLinha;      /* Linha atual do jogador no mapa           */
int  jColuna;     /* Coluna atual do jogador no mapa          */
int  jVidas;      /* Vidas restantes (comeca com 3)           */
int  jArma;       /* Arma equipada: 1=Espada 2=Arco 3=Cajado  */
char jDirecao;    /* Direcao: '^' cima 'v' baixo '<' esq '>' */
int  jChaves;     /* Quantas chaves o jogador carrega         */

/*
   DADOS DOS MONSTROS (arrays paralelos):

   Em vez de um array de structs (monstros[i].linha),
   usamos ARRAYS SEPARADOS que caminham juntos pelo indice.
   O monstro de indice i tem:
     mLinha[i]  -> linha no mapa
     mColuna[i] -> coluna no mapa
     mTipo[i]   -> 1=X aleatorio, 2=Y perseguicao, 3=Z boss
     mVivo[i]   -> 1=vivo, 0=morto

   Exemplo: para acessar o segundo monstro usamos
     mLinha[1], mColuna[1], mTipo[1], mVivo[1]
*/
int mLinha[MAX_MONSTROS];
int mColuna[MAX_MONSTROS];
int mTipo[MAX_MONSTROS];
int mVivo[MAX_MONSTROS];
int numMonstros = 0;   /* Quantos monstros existem na fase atual */

/* Contador de turnos do boss (para o comportamento de teleporte) */
int turnosBoss = 0;

/*
   MAPAS:
   Cada fase tem dois arrays 2D de char:
     - O mapa ATIVO: sofre alteracoes durante o jogo
       (chave some, caixa destruida, porta abre...)
     - O mapa ORIGINAL: copia intocada usada para
       REINICIAR a fase quando o jogador perde uma vida

   Um array 2D de char e essencialmente uma grade de celulas,
   onde cada celula e um caractere ASCII representando
   parede, chao, item, etc.
*/
char mapaVila[VILA_L][MAX_C];
char mapaVilaOrig[VILA_L][MAX_C];

char mapaA1[A1_L][MAX_C];
char mapaA1Orig[A1_L][MAX_C];

char mapaA2[A2_L][MAX_C];
char mapaA2Orig[A2_L][MAX_C];

char mapaA3[A3_L][MAX_C];
char mapaA3Orig[A3_L][MAX_C];

/* ===========================================================
   [3] FUNCOES UTILITARIAS
   ===========================================================

   Funcoes pequenas sem logica de jogo, usadas como
   ferramentas em varios lugares do codigo.
*/

/* -------------------------------------------------------
   limparTela()
   Apaga o console antes de redesenhar o mapa.
   _WIN32 e uma macro automaticamente definida em compiladores
   Windows. Assim o codigo funciona em qualquer sistema.
*/
void limparTela() {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

/* -------------------------------------------------------
   pausar()
   Congela a tela e espera o jogador pressionar ENTER.
   Util para que o jogador leia mensagens antes de continuar.

   O loop "while (c != '\n')" descarta tudo que estiver
   sobrando no buffer de entrada (ex: o '\n' deixado por
   um scanf() anterior), evitando que o programa pule
   a pausa automaticamente.
*/
void pausar() {
    printf("\n  [Pressione ENTER para continuar...]");
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
    getchar();
}

/* -------------------------------------------------------
   lerChar()
   Le um unico caractere do teclado.
   O espaco antes de %c faz o scanf ignorar espacos e
   quebras de linha que ficaram no buffer.
*/
char lerChar() {
    char c;
    scanf(" %c", &c);
    return c;
}

/* -------------------------------------------------------
   lerInt()
   Le um numero inteiro e limpa o '\n' do buffer em seguida.
*/
int lerInt() {
    int n;
    scanf("%d", &n);
    while (getchar() != '\n');
    return n;
}

