/* -------------------------------------------------------
   exibirMapa
   Percorre o mapa linha por linha e coluna por coluna,
   imprimindo cada caractere.
   O jogador NAO fica salvo no array do mapa. Na hora de
   imprimir, verificamos se a celula atual e a posicao do
   jogador: se for, imprimimos jDirecao em vez do char do mapa.
   Isso evita o problema de "rastro" ao mover o jogador.
*/
void exibirMapa(char mapa[][MAX_C], int linhas, int colunas) {
    int i, j;
    for (i = 0; i < linhas; i++) {
        printf("  ");
        for (j = 0; j < colunas; j++) {
            if (i == jLinha && j == jColuna)
                printf("%c", jDirecao);
            else
                printf("%c", mapa[i][j]);
        }
        printf("\n");
    }
    printf("\n");
}

