/* -------------------------------------------------------
   limparTela
   Apaga o console antes de redesenhar o mapa.
   Usa "cls" no Windows e "clear" no Linux/Mac.
   _WIN32 e uma macro automaticamente definida em
   compiladores Windows.
*/
void limparTela() {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

/* -------------------------------------------------------
   pausar
   Congela a tela e espera o jogador pressionar ENTER.
   O loop while descarta tudo que sobrou no buffer de
   entrada antes de esperar o ENTER do usuario.
*/
void pausar() {
    printf("\n  [Pressione ENTER para continuar...]");
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
    getchar();
}

/* -------------------------------------------------------
   lerChar
   Le um unico caractere do teclado.
   O espaco antes de %c faz o scanf ignorar espacos e
   quebras de linha que ficaram no buffer.
*/
char lerChar() {
    char c;
    scanf(" %c", &c);
    return c;
}

/* -------------------------------------------------------
   lerInt
   Le um numero inteiro e descarta o '\n' do buffer.
*/
int lerInt() {
    int n;
    scanf("%d", &n);
    while (getchar() != '\n');
    return n;
}

