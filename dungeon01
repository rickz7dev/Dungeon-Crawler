/* -------------------------------------------------------
   reiniciarFase()
   Restaura o mapa ao estado original e reposiciona o jogador.
   Chamada sempre que o jogador perde uma vida.

   strncpy(mapa[i], orig[i], ...) copia cada linha do
   backup de volta para o mapa ativo, desfazendo todas
   as alteracoes feitas durante a tentativa.
*/
void reiniciarFase(char mapa[][MAX_C], char orig[][MAX_C],
                   int linhas, int colunas,
                   int lIni, int cIni) {
    int i;
    for (i = 0; i < linhas; i++)
        strncpy(mapa[i], orig[i], colunas + 1);

    jLinha   = lIni;
    jColuna  = cIni;
    jDirecao = '>';
    jChaves  = 0;

    /* Re-escaneia: os monstros voltam as posicoes originais */
    escanearMonstros(mapa, linhas, colunas);
}

