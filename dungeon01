   Ponto de entrada do programa. O compilador comeca aqui.

   srand(time(NULL)):
     "Semeia" o gerador de numeros aleatorios com o
     horario atual. Sem isso, rand() geraria a mesma
     sequencia toda vez que o jogo fosse aberto.

   O while(1) e o loop principal do menu.
   Ele so termina quando o jogador escolhe "Sair" (break).

   Fluxo da opcao Jogar:
     1. Inicializa dados do jogador
     2. Fase: Vila (escolha de arma)
     3. Fase: Andar 1 -> verifica retorno
     4. Fase: Andar 2 -> verifica retorno
     5. Fase: Andar 3 -> verifica retorno (vitoria ou game over)
*/
int main() {
    srand((unsigned int)time(NULL));

    while (1) {
        exibirMenu();
        char opcao = lerChar();

        /* ======= OPCAO 1: JOGAR ======= */
        if (opcao == '1') {

            /* Inicializa o jogador do zero */
            jVidas   = 3;
            jArma    = 0;
            jChaves  = 0;
            jDirecao = '>';
            jLinha   = 1;
            jColuna  = 1;

            /* Fase: Vila */
            faseVila();

            /* Fase: Andar 1 */
            inicializarAndar1();
            int res = loopFase(
                mapaA1, mapaA1Orig, A1_L, A1_C, 1, 1,
                "ANDAR 1 - Entrada da Masmorra", 0, NULL
            );
            if (res == 0) { exibirGameOver(); continue; }

            /* Fase: Andar 2 */
            inicializarAndar2();
            res = loopFase(
                mapaA2, mapaA2Orig, A2_L, A2_C, 1, 1,
                "ANDAR 2 - Corredor dos Espinhos", 0, efeitoBotaoA2
            );
            if (res == 0) { exibirGameOver(); continue; }

            /* Fase: Andar 3 */
            inicializarAndar3();
            res = loopFase(
                mapaA3, mapaA3Orig, A3_L, A3_C, 1, 1,
                "ANDAR 3 - Camara de Malachar", 1, efeitoBotaoA3
            );
            if (res == 0) exibirGameOver();
            else          exibirVitoria();

        /* ======= OPCAO 2: TUTORIAL ======= */
        } else if (opcao == '2') {
            exibirTutorial();

        /* ======= OPCAO 3: SAIR ======= */
        } else if (opcao == '3') {
            limparTela();
            printf("\n  ===== CREDITOS =====\n\n");
            printf("  Desenvolvido por:\n");
            printf("    * [SEU NOME AQUI]\n");
            printf("    * [INTEGRANTE 2]\n");
            printf("    * [INTEGRANTE 3]\n\n");
            printf("  Obrigado por jogar DUNGEON CRAWLER!\n\n");
            break;

        } else {
            printf("\n  [!] Opcao invalida!\n");
            pausar();
        }
    }

    return 0;
}
