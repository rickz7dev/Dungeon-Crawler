/* -------------------------------------------------------
   faseVila()
   Loop da Vila. Sem monstros. O jogador deve:
     1. Falar com o NPC (N) para escolher a arma
     2. Usar a escada (L) para entrar na masmorra

   Se tentar entrar sem arma, o jogo bloqueia e avisa.
*/
void faseVila() {
    inicializarVila();

    while (1) {
        limparTela();
        exibirHUD();
        printf("  === VILA DE ARENDOR ===\n");
        printf("  Fale com o NPC (N) para escolher sua arma.\n");
        printf("  Entre pela escada (L) para avancar.\n\n");

        exibirMapa(mapaVila, VILA_L, VILA_C);

        printf("  Comando (w/a/s/d/i): ");
        char cmd = lerChar();

        int dl = 0, dc = 0;
        char dir = jDirecao;

        if      (cmd == 'w') { dl = -1; dir = '^'; }
        else if (cmd == 's') { dl =  1; dir = 'v'; }
        else if (cmd == 'a') { dc = -1; dir = '<'; }
        else if (cmd == 'd') { dc =  1; dir = '>'; }
        else if (cmd == 'i') {
            int fl, fc;
            celulaDaFrente(&fl, &fc);

            if (fl >= 0 && fl < VILA_L && fc >= 0 && fc < VILA_C
                && mapaVila[fl][fc] == 'N') {
                if (jArma == 0)
                    escolherArma();
                else {
                    printf("\n  [!] Voce ja tem uma arma equipada!\n");
                    pausar();
                }
            } else {
                int dummy = 0;
                interagir(mapaVila, VILA_L, VILA_C, &dummy);
                pausar();
            }
            continue;
        }

        if (dl != 0 || dc != 0) {
            int res = moverJogador(mapaVila, VILA_L, VILA_C, dl, dc, dir);
            if (res == 2) {
                if (jArma == 0) {
                    printf("\n  [!] Fale com o NPC antes de entrar!\n");
                    jLinha  -= dl;
                    jColuna -= dc;
                    pausar();
                } else {
                    return;  /* Sai da Vila */
                }
            }
        }
    }
}

