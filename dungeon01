/* -------------------------------------------------------
   exibirHUD()
   HUD (Heads-Up Display) e o painel de informacoes do jogador.
   Aparece acima do mapa em toda iteracao do loop de jogo.

   Vidas cheias sao mostradas como [*] e perdidas como [ ].
   Exemplo com 2 vidas: [*] [*] [ ]

   Como fazemos isso:
     - Primeiro loop: de 0 ate jVidas  -> imprime [*]
     - Segundo loop:  de jVidas ate 3  -> imprime [ ]
*/
void exibirHUD() {
    /* Array de strings para traduzir o numero da arma em nome */
    const char *nomeArma[] = { "---", "Espada", "Arco e Flecha", "Cajado" };

    printf("============================================================\n");
    printf("  VIDAS: ");
    int i;
    for (i = 0; i < jVidas; i++)  printf("[*] ");
    for (i = jVidas; i < 3; i++)  printf("[ ] ");
    printf("  |  ARMA: %s  |  CHAVES: %d\n", nomeArma[jArma], jChaves);
    printf("============================================================\n");
}

/* -------------------------------------------------------
   exibirMapa()
   Percorre o mapa linha por linha, coluna por coluna,
   imprimindo cada caractere.

   TRUQUE IMPORTANTE — o jogador nao fica salvo no mapa:
   O array do mapa contem apenas o "chao" (paredes, itens,
   portas, etc.). Na hora de imprimir, verificamos se a
   posicao atual e a do jogador: se for, imprimimos jDirecao
   em vez do char do mapa.

   Isso resolve o problema de "apagar" o jogador do mapa
   ao se mover — simplesmente ele nunca esta salvo la.

   Parametros:
     mapa    -> o array 2D a ser impresso
     linhas  -> quantas linhas tem o mapa
     colunas -> quantas colunas tem o mapa
*/
void exibirMapa(char mapa[][MAX_C], int linhas, int colunas) {
    int i, j;
    for (i = 0; i < linhas; i++) {
        printf("  ");
        for (j = 0; j < colunas; j++) {
            if (i == jLinha && j == jColuna)
                printf("%c", jDirecao);   /* Posicao do jogador */
            else
                printf("%c", mapa[i][j]); /* Celula normal do mapa */
        }
        printf("\n");
    }
    printf("\n");
}

