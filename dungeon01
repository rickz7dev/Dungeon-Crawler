/* -------------------------------------------------------
   loopFase()
   O nucleo do jogo: loop principal de uma fase de masmorra.

   Executa indefinidamente ate uma de tres condicoes:
     -> Retorna 0: jogador ficou sem vidas (Game Over)
     -> Retorna 1: chegou na escada (proxima fase)
     -> Retorna 2: boss derrotado (vitoria, so Andar 3)

   A cada iteracao do loop:
     1. Checa vitoria (boss morto)
     2. Aplica efeito de botao se pressionado
     3. Limpa tela e exibe HUD + mapa
     4. Le comando do jogador
     5. Executa acao (mover / interagir / atacar)
     6. Move os monstros
     7. Trata perda de vida (reinicia fase se necessario)

   Parametros:
     mapa, orig      -> mapa ativo e backup
     linhas, cols    -> dimensoes
     lIni, cIni      -> posicao inicial do jogador
     nome            -> nome da fase (exibido no cabecalho)
     temBoss         -> 1 se deve checar vitoria por boss
     efeitoBotao     -> ponteiro para funcao do efeito do botao
                        (cada fase passa a sua propria funcao)
*/
int loopFase(char mapa[][MAX_C], char orig[][MAX_C],
             int linhas, int cols,
             int lIni, int cIni,
             const char *nome, int temBoss,
             void (*efeitoBotao)(char[][MAX_C])) {

    jLinha   = lIni;
    jColuna  = cIni;
    jDirecao = '>';
    jChaves  = 0;

    escanearMonstros(mapa, linhas, cols);

    int botaoAtivado = 0;

    while (1) {

        /* --- Condicao de vitoria: boss morto --- */
        if (temBoss && !bossEstaVivo())
            return 2;

        /* --- Efeito do botao (executa apenas uma vez) ---
           efeitoBotao e um ponteiro de funcao.
           efeitoBotao != NULL garante que existe uma funcao.
           Depois de executar, zeramos o ponteiro para nao
           rodar de novo nas proximas iteracoes. */
        if (botaoAtivado && efeitoBotao != NULL) {
            efeitoBotao(mapa);
            efeitoBotao = NULL;
        }

        /* --- Exibicao --- */
        limparTela();
        exibirHUD();
        if (temBoss)
            printf("  === %s === [Boss: %s]\n",
                   nome, bossEstaVivo() ? "VIVO" : "MORTO");
        else
            printf("  === %s === [Monstros: %d]\n",
                   nome, contarMonstrosVivos());

        desenharMonstros(mapa);
        exibirMapa(mapa, linhas, cols);
        limparMonstrosDoMapa(mapa);

        /* --- Input --- */
        printf("  Comando (w/a/s/d/i/o): ");
        char cmd = lerChar();

        int dl = 0, dc = 0;
        char dir = jDirecao;
        int resultado = 0;

        if      (cmd == 'w') { dl = -1; dir = '^'; }
        else if (cmd == 's') { dl =  1; dir = 'v'; }
        else if (cmd == 'a') { dc = -1; dir = '<'; }
        else if (cmd == 'd') { dc =  1; dir = '>'; }

        else if (cmd == 'i') {
            interagir(mapa, linhas, cols, &botaoAtivado);
            pausar();
            continue;
        }

        else if (cmd == 'o') {
            atacar(mapa, linhas, cols);
            /* Monstros tambem se movem apos o ataque */
            resultado = moverMonstros(mapa, linhas, cols);
            if (resultado) {
                if (jVidas <= 0) { pausar(); return 0; }
                pausar();
                reiniciarFase(mapa, orig, linhas, cols, lIni, cIni);
                botaoAtivado = 0;
            } else {
                pausar();
            }
            continue;
        }

        else {
            printf("\n  [!] Comando invalido. Use w/a/s/d/i/o\n");
            pausar();
            continue;
        }

        /* --- Movimento do jogador --- */
        resultado = moverJogador(mapa, linhas, cols, dl, dc, dir);

        if (resultado == 1) {
            /* Morreu */
            if (jVidas <= 0) { pausar(); return 0; }
            pausar();
            reiniciarFase(mapa, orig, linhas, cols, lIni, cIni);
            botaoAtivado = 0;
            continue;
        }
        if (resultado == 2)
            return 1;  /* Escada: proximo andar */

        /* --- Monstros se movem apos o jogador --- */
        resultado = moverMonstros(mapa, linhas, cols);
        if (resultado) {
            if (jVidas <= 0) { pausar(); return 0; }
            pausar();
            reiniciarFase(mapa, orig, linhas, cols, lIni, cIni);
            botaoAtivado = 0;
        }
    }
}

