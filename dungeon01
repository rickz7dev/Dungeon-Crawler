/* -------------------------------------------------------
   reiniciarFase
   Restaura o mapa ao estado original e reposiciona o jogador.
   Chamada sempre que o jogador perde uma vida.
   strncpy copia cada linha do backup (orig) de volta para
   o mapa ativo, desfazendo todas as alteracoes da tentativa.
*/
void reiniciarFase(char mapa[][MAX_C], char orig[][MAX_C],
                   int linhas, int colunas, int lIni, int cIni) {
    int i;
    for (i = 0; i < linhas; i++)
        strncpy(mapa[i], orig[i], colunas + 1);
    jLinha   = lIni;
    jColuna  = cIni;
    jDirecao = '>';
    jChaves  = 0;
    escanearMonstros(mapa, linhas, colunas);
}

/* -------------------------------------------------------
   aplicarEfeitoBotao
   Executa o efeito do botao da fase indicada pelo parametro fase.
   Fase 2: remove paredes centrais abrindo uma passagem secreta.
   Fase 3: adiciona dois monstros Tipo 2 extras nos arrays,
           aumentando o perigo na arena do boss.
   Usa if (fase == X) em vez de ponteiro de funcao.
*/
void aplicarEfeitoBotao(char mapa[][MAX_C], int fase) {
    if (fase == 2) {
        if (mapa[7][7] == '*') mapa[7][7] = ' ';
        if (mapa[7][6] == '*') mapa[7][6] = ' ';
        printf("\n  [!] Uma passagem secreta se abriu!\n");
    }
    if (fase == 3) {
        if (numMonstros < MAX_MONSTROS - 1) {
            mLinha[numMonstros]  = 21;
            mColuna[numMonstros] = 5;
            mTipo[numMonstros]   = 2;
            mVivo[numMonstros]   = 1;
            numMonstros++;
            mLinha[numMonstros]  = 21;
            mColuna[numMonstros] = 8;
            mTipo[numMonstros]   = 2;
            mVivo[numMonstros]   = 1;
            numMonstros++;
        }
        printf("\n  [!!] Armadilha! Novos inimigos surgiram!\n");
    }
}

